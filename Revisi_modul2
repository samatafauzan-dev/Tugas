CREATE DATABASE peminjaman_alat_laboratorium_new;
USE  peminjaman_alat_laboratorium_new;

CREATE TABLE mahasiswa (
mahasiswa_id CHAR(6) PRIMARY KEY,
nama_mahasiswa VARCHAR(100) NOT NULL,
email VARCHAR(100) NOT NULL,
status_aktif BOOLEAN 

);

SELECT * FROM mahasiswa;

CREATE TABLE petugas (
petugas_id CHAR(6) PRIMARY KEY,
nama_petugas VARCHAR(100) NOT NULL,
email_petugas VARCHAR(100) NOT NULL
);

SELECT * FROM petugas;

CREATE TABLE ruang_laboratorium (
ruang_id CHAR(6) PRIMARY KEY,
nama_ruang VARCHAR(100) NOT NULL,
gedung VARCHAR(100) NOT NULL,
lantai INT NOT NULL 
);

ALTER TABLE ruang_laboratorium MODIFY gedung VARCHAR(50);

SELECT * FROM ruang_laboratorium;


CREATE TABLE pemasok (
pemasok_id CHAR(6) PRIMARY KEY,
nama_pemasok VARCHAR(100) NOT NULL,
telepon VARCHAR(20) NOT NULL,
email_pemasok VARCHAR(100) NULL
);

SELECT * FROM pemasok;

CREATE TABLE kategori_alat (
kategori_id CHAR(6) PRIMARY KEY,
nama_kategori VARCHAR(50) NOT NULL
);

SELECT * FROM kategori_alat;

CREATE TABLE peminjaman (
peminjaman_id CHAR(6) PRIMARY KEY,
tanggal_pinjam DATE NOT NULL,
batas_kembali DATE NOT NULL,
tanggal_pengembalian DATE NULL,
mahasiswa_mahasiswa_id CHAR(6) NOT NULL,
petugas_petugas_id  CHAR(6) NOT NULL,

CONSTRAINT fk_peminjaman_petugas FOREIGN KEY (petugas_petugas_id)
REFERENCES petugas(petugas_id)
ON DELETE RESTRICT
ON UPDATE CASCADE,


CONSTRAINT fk_peminjaman_mahasiswa FOREIGN KEY (mahasiswa_mahasiswa_id)
REFERENCES mahasiswa(mahasiswa_id)
ON DELETE RESTRICT
ON UPDATE CASCADE 
);

CREATE TABLE alat (
alat_id CHAR(6) PRIMARY KEY,
nama_alat VARCHAR(100) NOT NULL,
kondisi VARCHAR(20) NOT NULL,
status_alat VARCHAR(20) NOT NULL,
tanggal_pengadaan DATE NOT NULL,
kategori_alat_kategori_id CHAR(6) NOT NULL, 
ruang_laboratorium_ruang_id CHAR(6) NOT NULL,
pemasok_pemasok_id CHAR(6) NOT NULL,

CONSTRAINT fk_alat_ruang_laboratorium FOREIGN KEY (ruang_laboratorium_ruang_id)
REFERENCES ruang_laboratorium(ruang_id)
ON DELETE RESTRICT
ON UPDATE CASCADE,

CONSTRAINT fk_alat_pemasok FOREIGN KEY (pemasok_pemasok_id)
REFERENCES pemasok (pemasok_id)
ON DELETE RESTRICT
ON UPDATE CASCADE,

CONSTRAINT fk_alat_kategori_alat FOREIGN KEY (kategori_alat_kategori_id)
REFERENCES kategori_alat (kategori_id)
ON DELETE RESTRICT
ON UPDATE CASCADE
);

CREATE TABLE detail_peminjaman (
peminjaman_peminjaman_id CHAR(6),
alat_alat_id CHAR(6),  
PRIMARY KEY (peminjaman_peminjaman_id, alat_alat_id),

CONSTRAINT fk_detail_peminjaman_peminjaman FOREIGN KEY (peminjaman_peminjaman_id)
REFERENCES peminjaman(peminjaman_id)
ON DELETE RESTRICT
ON UPDATE CASCADE,

CONSTRAINT fk_detail_peminjaman_alat FOREIGN KEY (alat_alat_id)
REFERENCES alat(alat_id)
ON DELETE RESTRICT
ON UPDATE CASCADE
);
ALTER TABLE  mahasiswa MODIFY email VARCHAR(100) UNIQUE;
ALTER TABLE  petugas MODIFY email_petugas VARCHAR(100) UNIQUE;
ALTER TABLE  kategori_alat MODIFY nama_kategori VARCHAR(50) UNIQUE;


