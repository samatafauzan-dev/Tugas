-- TechFest ITS 2026 (MySQL 8+) - gunakan database kosong yang dipilih.
DROP TABLE IF EXISTS jadwal_presentasi;
DROP TABLE IF EXISTS pendanaan;
DROP TABLE IF EXISTS sponsor;
DROP TABLE IF EXISTS pendaftaran;
DROP TABLE IF EXISTS anggota_tim;
DROP TABLE IF EXISTS tim;
DROP TABLE IF EXISTS kompetisi;
DROP TABLE IF EXISTS mahasiswa;
DROP TABLE IF EXISTS program_studi;

CREATE TABLE program_studi (
  id_prodi INT PRIMARY KEY,
  nama_prodi VARCHAR(100) NOT NULL UNIQUE
);
CREATE TABLE mahasiswa (
  nrp VARCHAR(14) PRIMARY KEY,
  nama_mahasiswa VARCHAR(100) NOT NULL,
  ipk DECIMAL(3,2) NOT NULL,
  id_prodi INT NOT NULL,
  FOREIGN KEY (id_prodi) REFERENCES program_studi(id_prodi)
);
CREATE TABLE kompetisi (
  id_kompetisi INT PRIMARY KEY,
  nama_kompetisi VARCHAR(100) NOT NULL,
  kategori VARCHAR(30) NOT NULL,
  kuota_tim INT NOT NULL,
  tanggal_mulai DATE NOT NULL,
  status_kompetisi VARCHAR(20) NOT NULL
);
CREATE TABLE tim (
  id_tim INT PRIMARY KEY,
  nama_tim VARCHAR(100) NOT NULL,
  id_kompetisi INT NOT NULL,
  FOREIGN KEY (id_kompetisi) REFERENCES kompetisi(id_kompetisi)
);
CREATE TABLE anggota_tim (
  id_tim INT NOT NULL,
  nrp VARCHAR(14) NOT NULL,
  PRIMARY KEY (id_tim, nrp),
  FOREIGN KEY (id_tim) REFERENCES tim(id_tim),
  FOREIGN KEY (nrp) REFERENCES mahasiswa(nrp)
);
CREATE TABLE pendaftaran (
  id_pendaftaran INT PRIMARY KEY,
  id_tim INT NOT NULL UNIQUE,
  waktu_daftar DATETIME NOT NULL,
  status_pendaftaran VARCHAR(20) NOT NULL,
  FOREIGN KEY (id_tim) REFERENCES tim(id_tim)
);
CREATE TABLE sponsor (
  id_sponsor INT PRIMARY KEY,
  nama_sponsor VARCHAR(100) NOT NULL
);
CREATE TABLE pendanaan (
  id_pendanaan INT PRIMARY KEY,
  id_sponsor INT NOT NULL,
  id_kompetisi INT NOT NULL,
  nominal DECIMAL(14,2) NOT NULL,
  FOREIGN KEY (id_sponsor) REFERENCES sponsor(id_sponsor),
  FOREIGN KEY (id_kompetisi) REFERENCES kompetisi(id_kompetisi)
);
CREATE TABLE jadwal_presentasi (
  id_jadwal INT PRIMARY KEY,
  id_tim INT NOT NULL,
  waktu_presentasi DATETIME NOT NULL,
  lokasi VARCHAR(100) NOT NULL,
  FOREIGN KEY (id_tim) REFERENCES tim(id_tim)
);

